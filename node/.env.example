PORT=3456

# PostgreSQL (migrate + app pool). Preferred: DATABASE_URL for Neon/Railway/Render (SSL in URL).
# Example: DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
# When DATABASE_URL is set, discrete DB_* below are ignored.
DATABASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres

# Comma-separated origins that can call this API (e.g. your Next.js app URL).
CORS_ORIGIN=http://localhost:3000

# Must be identical to Next.js (site) JWT_SECRET – tokens are signed there and verified here
JWT_SECRET=

# OAuth (Passport): register redirect URIs exactly as PUBLIC_API_URL + path (e.g. http://YOUR_LAN_IP:3456/api/oauth/google/callback).
PUBLIC_API_URL=http://localhost:3456
OAUTH_APP_REDIRECT_URI=deedyte://oauth

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3456/api/oauth/google/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# FACEBOOK_CALLBACK_URL=http://localhost:3456/api/oauth/facebook/callback

# Paystack: use sk_test_… when Dashboard is in Test mode (matches mobile pk_test_). sk_live_ for production only.
# PAYSTACK_SECRET_KEY must match the mode in Paystack Dashboard (same secret signs webhooks).
# This API listens at: POST {PUBLIC_API_URL}/webhooks/paystack (application/json raw body — required for HMAC).
# Duplicate deliveries (identical body) are deduped; run `npm run migrate` for table paystack_webhook_deliveries.
#
# Test webhook URL you use (e.g. Vercel proxy): https://payment-route.vercel.app/flw-webhook
# If that route is in front of this API, it must forward the unchanged request body and the `x-paystack-signature`
# header to POST …/webhooks/paystack, or verification here will fail. Paystack Dashboard can point at the proxy URL.
PAYSTACK_SECRET_KEY=

# HTTPS (optional). When SSL_KEY_PATH and SSL_CERT_PATH are both set and readable, the server uses TLS; otherwise it listens on HTTP (local dev).
# If only one path is set, or files are missing/invalid, the server falls back to HTTP with a console warning.
# Generate a local dev cert: openssl req -x509 -newkey rsa:2048 -nodes -keyout key.pem -out cert.pem -days 365 -subj "/CN=localhost"
# SSL_KEY_PATH=key.pem
# SSL_CERT_PATH=cert.pem
# Optional intermediate / chain file:
# SSL_CA_PATH=chain.pem
