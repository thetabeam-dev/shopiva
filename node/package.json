{
  "name": "node",
  "version": "1.0.0",
  "description": "server for deedyte",
  "license": "ISC",
  "author": "Akpulu Chinedu Fabian",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "build": "tsc --skipLibCheck && node scripts/copy-tsx-files.js",
    "lint": "eslint \"src\" --fix",
    "start": "tsc && node scripts/copy-tsx-files.js && pm2-runtime start ecosystem.config.cjs --env production",
    "dev": "tsc && node scripts/copy-tsx-files.js && pm2-runtime start ecosystem.config.cjs --env development --watch",
    "local": "nodemon",
    "stop": "pm2 stop ecosystem.config.cjs",
    "restart": "pm2 restart ecosystem.config.cjs",
    "migrate": "tsc src/database/migrate.ts --outDir dist/database --module nodenext --target esnext --moduleResolution nodenext --esModuleInterop --skipLibCheck && npx dotenv-cli -e .env -- node dist/database/migrate.js",
    "migrate:baseline": "npx dotenv-cli -e ./.env -- npx --yes tsx src/database/baseline-migrations.ts",
    "seed:demo": "npx dotenv-cli -e ./.env -- npx --yes tsx src/database/seed-vendors-products.ts",
    "db:reset-products": "npx dotenv-cli -e ./.env -- npx --yes tsx src/database/reset-products-inventory.ts",
    "seed:more-products": "npx dotenv-cli -e ./.env -- npx --yes tsx src/database/seed-products-existing-shops.ts",
    "update:shops-lagos": "npx dotenv-cli -e ./.env -- npx --yes tsx src/database/update-shops-lagos-location.ts",
    "update:shops-half-anambra": "npx dotenv-cli -e ./.env -- npx --yes tsx src/database/update-half-shops-anambra.ts",
    "seed:cart-user": "npx dotenv-cli -e ./.env -- npx --yes tsx src/database/seed-cart-for-user.ts",
    "seed:disputes-shop": "npx dotenv-cli -e ./.env -- npx --yes tsx src/database/seed-disputes-for-shop.ts",
    "seed:disputes-shop:local": "SEED_TARGET=local npx --yes tsx src/database/seed-disputes-for-shop.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.0.3",
    "@types/nodemailer": "^7.0.4",
    "@types/passport": "^1.0.17",
    "@types/passport-facebook": "^3.0.4",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv-cli": "^11.0.0",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@sentry/node": "^10.31.0",
    "@types/cors": "^2.8.19",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.1",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "https": "^1.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.11",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.16.3",
    "sentry": "^0.1.2",
    "short-id": "^0.1.0-1",
    "socket-io": "^1.0.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0"
  }
}
