# App URLs (set in .env for all API/backend calls)
# Site origin (client + server). Google OAuth rejects private IPs in the callback URL
# (error: device_id and device_name are required for private IP). Use e.g.
# https://localhost:3001, an ngrok/Cloudflare Tunnel URL, or production HTTPS —
# and add the same origin + /api/auth/callback/google in Google Cloud Console.
NEXT_PUBLIC_API_URL=
# Optional override for NextAuth only (defaults to NEXT_PUBLIC_API_URL). Use when
# you need a public tunnel URL for OAuth while keeping something else for APIs.
# NEXTAUTH_URL=
# Node backend. e.g. http://localhost:3456 or http://<your-ip>:3456
# Social login on the site uses Passport on this API: /api/oauth/{google|facebook|apple}
# and returns to {site origin}/auth/oauth/callback
NEXT_PUBLIC_BACKEND_URL=

# Must be identical to Node backend JWT_SECRET so tokens signed here verify there (shop create, etc.)
JWT_SECRET=

# Neon PostgreSQL (waitlist). Get from Neon dashboard → Connection string.
# Example: postgresql://user:password@host/neondb?sslmode=require
WAITLIST_DATABASE_URL=

# Google Maps Geocoding API (shop location). Create at https://console.cloud.google.com/apis/credentials, enable Geocoding API.
GOOGLE_MAPS_API_KEY=
