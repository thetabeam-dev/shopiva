# Copy to `.env` in this folder (see `.gitignore`). Restart Metro after changes: `npx react-native start --reset-cache`
#
# Paystack TEST mode (Pistachio / dev): use keys from Dashboard with "Test" toggled ON.
# Public key only — never put secret keys (sk_…) in the mobile app.
#
# PAYSTACK_PUBLIC_KEY=pk_test_your_key_from_paystack_dashboard
